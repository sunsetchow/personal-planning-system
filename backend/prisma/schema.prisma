// Personal Planning System - Database Schema
// OKR tracking and daily journaling platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication and user management
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  objectives       Objective[]
  journalTemplates JournalTemplate[]
  journalEntries   JournalEntry[]
  aiInsights       AIInsight[]
  profile          UserProfile?
  timeSessions     TimeSession[]
  categoryMappings CategoryMapping[]
  weeklyCheckins   WeeklyCheckin[]

  @@map("users")
}

// User Profile model for context and personalization
model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  userType          String?  @map("user_type") // 'student', 'professional', 'entrepreneur', 'creator', etc.
  industry          String?  // Tech, Finance, Healthcare, etc.
  goals             Json?    // Array of primary goals
  focusAreas        Json?    @map("focus_areas") // Array of focus areas (e.g., Career, Health, Learning)
  workingHours      Json?    @map("working_hours") // Preferred working schedule
  timezone          String?  @default("UTC")
  customMetrics     Json?    @map("custom_metrics") // User-defined metrics to track
  preferences       Json?    // UI preferences, notification settings, etc.
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Objective model for OKR tracking
model Objective {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  title       String
  description String?        @db.Text
  periodType  PeriodType     @map("period_type")
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  status      ObjectiveStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyResults  KeyResult[]
  timeSessions TimeSession[]

  @@index([userId])
  @@index([status])
  @@map("objectives")
}

// Key Result model for measurable outcomes
model KeyResult {
  id           String          @id @default(uuid())
  objectiveId  String          @map("objective_id")
  title        String
  description  String?         @db.Text
  targetValue  Decimal         @map("target_value") @db.Decimal(10, 2)
  currentValue Decimal         @default(0) @map("current_value") @db.Decimal(10, 2)
  unit         String
  status       KeyResultStatus @default(ON_TRACK) @map("status")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relations
  objective   Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  okrUpdates  OkrUpdate[]

  @@index([objectiveId])
  @@index([status])
  @@map("key_results")
}

// Journal Template model for custom daily journal questions
model JournalTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  questions Json     // Array of question objects: [{id, question, type}]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([userId])
  @@index([isActive])
  @@map("journal_templates")
}

// Journal Entry model for daily reflections
model JournalEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  templateId  String   @map("template_id")
  entryDate   DateTime @map("entry_date") @db.Date
  responses   Json     // Question-answer pairs
  moodScore   Decimal? @map("mood_score") @db.Decimal(3, 1)
  energyScore Decimal? @map("energy_score") @db.Decimal(3, 1)
  aiFeedback  String?  @map("ai_feedback") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   JournalTemplate @relation(fields: [templateId], references: [id])
  okrUpdates OkrUpdate[]

  @@unique([userId, entryDate])
  @@index([userId])
  @@index([entryDate])
  @@map("journal_entries")
}

// OKR Update model for tracking changes and audit trail
model OkrUpdate {
  id             String         @id @default(uuid())
  keyResultId    String         @map("key_result_id")
  journalEntryId String?        @map("journal_entry_id")
  previousValue  Decimal        @map("previous_value") @db.Decimal(10, 2)
  newValue       Decimal        @map("new_value") @db.Decimal(10, 2)
  updateType     UpdateType     @map("update_type")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  keyResult    KeyResult     @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([keyResultId])
  @@index([journalEntryId])
  @@map("okr_updates")
}

// Time Session model for Pomodoro tracking
model TimeSession {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  title           String
  category        String?
  okrCategory     String?      @map("okr_category")
  objectiveId     String?      @map("objective_id")
  startTime       DateTime     @map("start_time")
  endTime         DateTime     @map("end_time")
  duration        Int          // Duration in seconds
  pauseDuration   Int          @default(0) @map("pause_duration")
  focusQuality    FocusQuality @map("focus_quality")
  tags            Json?
  notes           String?      @db.Text
  isCompleted     Boolean      @default(true) @map("is_completed")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startTime])
  @@index([okrCategory])
  @@index([objectiveId])
  @@map("time_sessions")
}

// Category Mapping model for linking user categories to OKR areas
model CategoryMapping {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  categoryName       String   @map("category_name")
  okrCategory        String   @map("okr_category")
  defaultObjectiveId String?  @map("default_objective_id")
  hexColor           String   @default("#2C50CF") @map("hex_color")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryName])
  @@index([userId, isActive])
  @@map("category_mappings")
}

// AI Insights Cache model for storing generated insights
model AIInsight {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  insightType           String   @map("insight_type") // 'dashboard', 'weekly', 'monthly'
  summary               String   @db.Text
  patterns              Json?    // Array of pattern strings
  recommendations       Json?    // Array of recommendation strings
  metrics               Json?    // Key metrics used for generation
  dataRange             Json     @map("data_range") // {startDate, endDate, entryCount, objectiveCount}
  lastJournalEntryDate  DateTime? @map("last_journal_entry_date") @db.Date
  generatedAt           DateTime @default(now()) @map("generated_at")
  expiresAt             DateTime? @map("expires_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, insightType])
  @@index([userId, lastJournalEntryDate])
  @@map("ai_insights")
}

// Weekly Check-in model for storing weekly reports and analyses
model WeeklyCheckin {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  weekStart       DateTime @map("week_start") @db.Date
  weekEnd         DateTime @map("week_end") @db.Date
  weeklyReport    String   @map("weekly_report") @db.Text
  weeklyJournal   String   @map("weekly_journal") @db.Text
  newsletter      String   @db.Text
  journalSummary  Json     @map("journal_summary")
  timeAnalysis    Json     @map("time_analysis")
  okrProgress     Json     @map("okr_progress")
  aiInsights      Json     @map("ai_insights")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, weekEnd])
  @@map("weekly_checkins")
}

// Enums
enum PeriodType {
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum ObjectiveStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KeyResultStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
}

enum UpdateType {
  MANUAL
  JOURNAL_SUGGESTED
  JOURNAL_AUTO
}

enum FocusQuality {
  FULL_FOCUS
  PARTIAL_FOCUS
  INTERRUPTED
  REST
}
